# Airflow image extended with pipeline dependencies (MLflow + agent/eval stack).
# Used by docker-compose.yaml. The root Dockerfile remains the agent/eval image
# for DockerOperator-style isolation.
FROM apache/airflow:2.10.5

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends docker.io git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

USER airflow
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt
