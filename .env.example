NEBIUS_API_KEY=XXX

# Local / standalone helpers
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_BACKEND_STORE_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=evaluate-agent

# Docker Compose (Airflow + MLflow)
# On Linux: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=mlops-airflow:2.10.5
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
